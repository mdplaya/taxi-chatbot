# OpenAI API Configuration
# Get your API key from https://platform.openai.com/api-keys
# If not provided, the system will run in OFFLINE mode using pattern matching
OPENAI_API_KEY=sk-your-openai-api-key-here

# LLM Configuration
# Timeout for LLM calls in milliseconds (default: 3000ms = 3 seconds)
LLM_TIMEOUT=3000

# Cache TTL for mode detection in seconds (default: 300s = 5 minutes)
LLM_CACHE_TTL=300

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Frontend Configuration (for production)
NEXT_PUBLIC_API_URL=http://localhost:8000

# MCP Server Configuration
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8001

# TAXI API Configuration (for production)
TAXI_API_URL=https://your-taxi-api-endpoint.com
TAXI_API_KEY=your-taxi-api-key
TAXI_API_TIMEOUT=30

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Agent Framework
AGENT_REASONING_MODEL=gpt-5-mini
