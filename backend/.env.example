# TAXI Chatbot Environment Configuration
# Copy this file to .env and update with your values

# OpenAI API Configuration
# Required for AI-powered features. System works without it using pattern matching.
OPENAI_API_KEY=your_openai_api_key_here

# Timeout Configuration (milliseconds for compatibility, converted to seconds internally)
# LLM timeout for API calls - default 75 seconds
LLM_TIMEOUT=75000

# Reasoning engine timeouts (seconds)
# Timeout for simple requests (basic VM provisioning)
REASONING_TIMEOUT_SIMPLE=60

# Timeout for complex requests (multi-step operations)
REASONING_TIMEOUT_COMPLEX=120

# Clarification agent timeout (seconds)
CLARIFICATION_TIMEOUT=60

# API request timeout (milliseconds) - for frontend/backend communication
API_TIMEOUT=90000

# Cache Configuration
# Time to cache LLM availability status (seconds)
LLM_CACHE_TTL=300

# Agent Configuration
# Maximum reasoning depth for agents
MAX_REASONING_DEPTH=5

# Minimum confidence threshold for agent decisions (0.0-1.0)
DECISION_CONFIDENCE_THRESHOLD=0.6

# Progress Tracking Configuration
# Enable Server-Sent Events for real-time progress
USE_SSE_PROGRESS=true

# Progress update interval (seconds)
PROGRESS_UPDATE_INTERVAL=2

# Maximum progress events to store per session
MAX_PROGRESS_EVENTS=100

# Session Configuration
# Session timeout (seconds) - how long to keep sessions in memory
SESSION_TIMEOUT=3600

# Maximum concurrent sessions
MAX_SESSIONS=100

# Development Configuration
# Enable debug logging
DEBUG=false

# API host and port (for local development)
API_HOST=0.0.0.0
API_PORT=8000

# MCP Server Configuration
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8001

# Agent Framework Configuration
AGENT_REASONING_MODEL=gpt-5-mini
AGENT_MEMORY_TTL=86400
MAX_REASONING_DEPTH=5
REASONING_TEMPERATURE=1.0  # gpt-5-mini only supports 1.0
DECISION_CONFIDENCE_THRESHOLD=0.6

# Valkey Configuration
VALKEY_HOST=localhost
VALKEY_PORT=6379
VALKEY_AGENT_DB=1
VALKEY_PASSWORD=  # Optional for local dev
VALKEY_SSL=false
VALKEY_CONNECTION_POOL_SIZE=10
VALKEY_MAX_CONNECTIONS=50

# Memory Management
AGENT_MEMORY_TTL=86400  # 24 hours
SHORT_TERM_MEMORY_TTL=3600  # 1 hour
LONG_TERM_MEMORY_TTL=604800  # 7 days
CORRECTION_MEMORY_TTL=2592000  # 30 days

# Learning Configuration
CORRECTION_LEARNING_THRESHOLD=0.8
PATTERN_CONFIDENCE_THRESHOLD=0.7
CROSS_SESSION_LEARNING=true
AGENT_REFLECTION_ENABLED=true
FEEDBACK_COLLECTION=true

# Security
MAX_CORRECTIONS_PER_MINUTE=10
PROMPT_INJECTION_PROTECTION=true
AGENT_ACTION_VALIDATION=true